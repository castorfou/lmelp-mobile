FROM python:3.11-slim

# Install ADB, gh CLI and system dependencies.
RUN apt-get update && apt-get install -y --no-install-recommends \
    android-tools-adb \
    curl \
    gcc \
    gpg \
    python3-dev \
    && curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
        -o /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
        > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update && apt-get install -y --no-install-recommends gh \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install Python dependencies depuis pyproject.toml (sans extras dev)
# On copie d'abord pyproject.toml seul pour bénéficier du cache Docker
COPY pyproject.toml README.md ./
# Stub src/ pour que pip install -e . réussisse sans le code source complet
RUN mkdir -p src && pip install --no-cache-dir -e .

# Copy export scripts
COPY scripts/export_mongo_to_sqlite.py scripts/
COPY scripts/generate_data_release_metadata.py scripts/
COPY scripts/notify_ntfy.py scripts/

# Entrypoint scripts
COPY scripts/docker_export_and_push.sh /usr/local/bin/export-and-push
RUN chmod +x /usr/local/bin/export-and-push
COPY scripts/docker_export_and_publish_release.sh /usr/local/bin/export-and-publish-release
RUN chmod +x /usr/local/bin/export-and-publish-release

COPY scripts/docker_publish_loop.sh /usr/local/bin/publish-loop
RUN chmod +x /usr/local/bin/publish-loop

# ---------------------------------------------------------------------------
# Publication périodique de data-v{N} (issue #153) : publish-loop tourne en
# arrière-plan, toutes les PUBLISH_INTERVAL secondes (défaut 3600), et notifie
# via ntfy les publications et les échecs (NTFY_TOPIC). Remplace l'ancien job
# anacron quotidien (issue #116), anacron ne descendant pas sous un jour.
# ---------------------------------------------------------------------------
RUN mkdir -p /var/lib/lmelp-export /var/log && \
    echo '#!/bin/bash' > /docker-entrypoint.sh && \
    echo 'set -e' >> /docker-entrypoint.sh && \
    echo 'publish-loop &' >> /docker-entrypoint.sh && \
    echo 'exec "$@"' >> /docker-entrypoint.sh && \
    chmod +x /docker-entrypoint.sh

ENTRYPOINT ["/docker-entrypoint.sh"]

# En mode daemon : le container reste actif, on appelle export-and-push /
# export-and-publish-release via docker exec (en plus de publish-loop ci-dessus)
CMD ["sleep", "infinity"]
